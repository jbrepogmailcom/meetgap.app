# Example Caddyfile for Meetgap production and staging.
# Place the relevant blocks in /etc/caddy/Caddyfile.

meetgap.app {
    reverse_proxy localhost:3002
    encode gzip zstd
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    log {
        output file /var/log/caddy/meetgap.log
        format json
    }
}

www.meetgap.app {
    redir https://meetgap.app{uri} permanent
}

staging.meetgap.app {
    reverse_proxy localhost:3003
    encode gzip zstd
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        X-Robots-Tag "noindex, nofollow"
        -Server
    }
    log {
        output file /var/log/caddy/meetgap-staging.log
        format json
    }
}
